# Runtime env for the PACKAGED app. Copied to Resources/app.env by
# electron-builder and read by getEnvFilePaths() at startup.
#
# Curated on purpose: only keys the shipped app needs. This file travels inside
# the distributed app, so treat everything here as public — anything that must
# stay private belongs on the backend.
#
# Gitignored. Recreate from .env.local with the two keys below.
OPENWAGGLE_APP_AUTH_GOOGLE_DESKTOP_CLIENT_ID=
OPENWAGGLE_APP_AUTH_GOOGLE_DESKTOP_CLIENT_SECRET=
